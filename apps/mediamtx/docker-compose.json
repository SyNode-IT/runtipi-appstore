{
  "schemaVersion": 2,
  "services": [
    {
      "name": "mediamtx",
      "image": "bluenviron/mediamtx:1.15.6",
      "hostname": "mediamtx",
      "isMain": true,
      "internalPort": "8889",
      "environment": {
        "MTX_PROTOCOLS": "tcp",
        "MTX_LOGLEVEL": "info",
        "MTX_LOGDESTINATIONS": "stdout",
        "MTX_RTSPADDRESS": ":8554",
        "MTX_RTMPADDRESS": ":1935",
        "MTX_HLSADDRESS": ":8888",
        "MTX_WEBRTCADDRESS": ":8889",
        "MTX_SRTADDRESS": ":8890",
        "MTX_APIADDRESS": ":9997",
        "MTX_METRICSADDRESS": ":9998",
        "MTX_AUTHINTERNALUSERS": "${MTX_API_USERNAME:+${MTX_API_USERNAME}:${MTX_API_PASSWORD}}",
        "MTX_PATHDEFAULTS_RECORD": "${MTX_RECORD_ENABLED:-false}",
        "MTX_PATHDEFAULTS_RECORDPATH": "./recordings/%path/%Y-%m-%d_%H-%M-%S-%f",
        "MTX_PATHDEFAULTS_RECORDFORMAT": "fmp4"
      },
      "addPorts": [
        {
          "containerPort": 8554,
          "hostPort": 8554,
          "tcp": true
        },
        {
          "containerPort": 8554,
          "hostPort": 8554,
          "udp": true
        },
        {
          "containerPort": 1935,
          "hostPort": 1935,
          "tcp": true
        },
        {
          "containerPort": 8888,
          "hostPort": 8888,
          "tcp": true
        },
        {
          "containerPort": 8890,
          "hostPort": 8890,
          "udp": true
        },
        {
          "containerPort": 8189,
          "hostPort": 8189,
          "udp": true
        },
        {
          "containerPort": 9997,
          "hostPort": 9997,
          "tcp": true
        },
        {
          "containerPort": 9998,
          "hostPort": 9998,
          "tcp": true
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/recordings",
          "containerPath": "/mediamtx/recordings"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/mediamtx/config"
        }
      ],
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "2.0",
            "memory": "2G"
          },
          "reservations": {
            "cpus": "1.0",
            "memory": "512M",
            "devices": []
          }
        }
      },
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://localhost:9997/v3/config/get || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "startPeriod": "10s"
      }
    }
  ]
}
