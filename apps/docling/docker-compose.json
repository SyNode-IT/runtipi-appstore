{
  "schemaVersion": 2,
  "services": [
    {
      "name": "docling",
      "image": "quay.io/docling-project/docling-serve-cpu:v1.37.0",
      "isMain": true,
      "internalPort": "5001",
      "environment": [
        {
          "key": "DOCLING_SERVE_ENABLE_REMOTE_SERVICES",
          "value": "true"
        },
        {
          "key": "DOCLING_SERVE_ENABLE_UI",
          "value": "false"
        },
        {
          "key": "DOCLING_SERVE_MAX_SYNC_WAIT",
          "value": "1800"
        },
        {
          "key": "UVICORN_WORKERS",
          "value": "1"
        },
        {
          "key": "DOCLING_SERVE_ENG_LOC_NUM_WORKERS",
          "value": "1"
        },
        {
          "key": "TZ",
          "value": "${TZ:-Europe/Paris}"
        },
        {
          "key": "DOCLING_SERVE_API_KEY",
          "value": "${DOCLING_API_KEY}"
        }
      ]
    }
  ]
}
